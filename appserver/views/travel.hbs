<!DOCTYPE html>
<!-- Website template by freewebsitetemplates.com -->
<html>
<head>
	<meta charset="UTF-8">
	<title>Dive Sites - Bhaccasyoniztas Beach Resort Website Template</title>
	<link rel="stylesheet" href="css/style.css" type="text/css">
</head>
<body>
	<div id="background">
		<div id="page">
			{{>header}}
			<div id="contents">
				<div class="box">
					<div>
						<div class="body">
							<h1>Travel</h1>
							<ul id="sites">
								{{#each trips}}
									<li>
										<a href="/travel" class="trip-link" data-tripcode="{{{this.code}}}"><img src="images/{{this.image}}" alt="Img"> </a>
										<h2><a href="/travel" class="trip-link" data-tripCode={{{this.code}}}> {{this.name}} </a></h2>
										{{{this.description}}}
									</li>
								{{/each}}
							</ul>
						</div>
					</div>
				</div>
			</div>
		</div>
		{{>footer}}
	</div>

	<!-->Script that tracks user clicks on this page, enhancement 2<-->
	<script src="/javascripts/userViews.js"></script>
</body>
</html>